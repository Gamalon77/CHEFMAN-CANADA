# ---- Shopify ----
# Your store domain (the *.myshopify.com one, not the custom domain)
SHOPIFY_SHOP=your-store.myshopify.com
# Admin API access token from a custom app with scopes:
#   read_translations, write_translations, read_products, read_content (pages/blogs),
#   read_online_store_navigation (menus), read_locales
SHOPIFY_ADMIN_TOKEN=shpat_xxx
# Admin API version
SHOPIFY_API_VERSION=2025-01
# The custom app's API secret key — used to verify webhook HMAC signatures
SHOPIFY_WEBHOOK_SECRET=shpss_xxx

# ---- Translation target ----
# Published storefront locale to write translations for (e.g. "fr" or "fr-CA")
TARGET_LOCALE=fr
# Never translate these field keys (translating a handle changes the URL)
SKIP_FIELDS=handle

# ---- Claude ----
# Read automatically by the Anthropic SDK
ANTHROPIC_API_KEY=sk-ant-xxx
# Model for translation (default: claude-opus-4-8). Swap to claude-sonnet-5 or
# claude-haiku-4-5 to trade quality for cost/latency.
MODEL=claude-opus-4-8

# ---- Service ----
PORT=3000
# When "true", translate + log but do NOT write back to Shopify (safe testing)
DRY_RUN=true
