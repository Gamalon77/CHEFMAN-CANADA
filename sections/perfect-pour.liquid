<style>
  #shopify-section-{{ section.id }} {
    --section-padding-top: {{ section.settings.padding_top }}px;
    --section-padding-bottom: {{ section.settings.padding_bottom }}px;
    {%- render 'section-variables', section: section -%}
  }

  #shopify-section-{{ section.id }} .pp {
    max-width: 640px;
    margin-inline: auto;
    text-align: center;
  }
  #shopify-section-{{ section.id }} .pp__intro {
    margin-top: var(--sp-3);
    color: rgb(var(--color-foreground) / 0.75);
  }

  #shopify-section-{{ section.id }} .pp__hud {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--sp-4);
    margin: var(--sp-8) auto var(--sp-3);
    max-width: 460px;
  }
  #shopify-section-{{ section.id }} .pp__stat {
    font-weight: 600;
    letter-spacing: 0.02em;
  }
  #shopify-section-{{ section.id }} .pp__stat span {
    font-variant-numeric: tabular-nums;
  }
  #shopify-section-{{ section.id }} .pp__lives {
    font-size: 1.1rem;
    letter-spacing: 2px;
    min-height: 1.2em;
  }
  #shopify-section-{{ section.id }} .pp__life--lost {
    opacity: 0.2;
  }
  #shopify-section-{{ section.id }} .pp__streak {
    margin: 0 auto var(--sp-2);
    min-height: 1.1em;
    font-size: 0.85rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    color: rgb(46 160 90);
    opacity: 0;
  }
  @media (prefers-reduced-motion: no-preference) {
    #shopify-section-{{ section.id }} .pp__streak {
      transition: opacity 0.2s ease;
    }
  }
  #shopify-section-{{ section.id }} .pp__streak.is-show {
    opacity: 1;
  }

  #shopify-section-{{ section.id }} .pp__stage {
    position: relative;
    width: 100%;
    max-width: 460px;
    margin-inline: auto;
    aspect-ratio: 3 / 4;
    border-radius: var(--rounded-block);
    overflow: hidden;
    background: #f1e3c9;
    border: 1px solid rgb(var(--color-border));
    touch-action: none;
    user-select: none;
  }
  #shopify-section-{{ section.id }} .pp__stage.is-hit {
    animation: pp-shake 0.3s ease;
  }
  #shopify-section-{{ section.id }} .pp__stage.is-hit::after {
    content: '';
    position: absolute;
    inset: 0;
    background: rgb(200 30 30 / 0.22);
    pointer-events: none;
    /* flash red, then fade smoothly back to grey (well under 3s) */
    animation: pp-flash 0.8s ease forwards;
  }
  #shopify-section-{{ section.id }} .pp__stage.is-good::after {
    content: '';
    position: absolute;
    inset: 0;
    background: rgb(46 160 90 / 0.20);
    pointer-events: none;
    animation: pp-flash 0.8s ease forwards;
  }
  @keyframes pp-flash {
    from { opacity: 1; }
    to { opacity: 0; }
  }
  @keyframes pp-shake {
    0%, 100% { transform: translateX(0); }
    25% { transform: translateX(-5px); }
    75% { transform: translateX(5px); }
  }
  #shopify-section-{{ section.id }} canvas {
    display: block;
    width: 100%;
    height: 100%;
    cursor: pointer;
    image-rendering: pixelated;
  }

  #shopify-section-{{ section.id }} .pp__overlay {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: var(--sp-4);
    padding: var(--sp-6);
    text-align: center;
    background: rgb(var(--color-background) / 0.9);
    backdrop-filter: blur(4px);
  }
  #shopify-section-{{ section.id }} .pp__overlay[hidden] {
    display: none;
  }
  #shopify-section-{{ section.id }} .pp__overlay p {
    color: rgb(var(--color-foreground) / 0.75);
    max-width: 22rem;
  }
  #shopify-section-{{ section.id }} .pp__score-big {
    font-variant-numeric: tabular-nums;
  }
  #shopify-section-{{ section.id }} .pp__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-3);
    justify-content: center;
  }
  /* On mobile, drop the "→ Shop coffee makers" suffix so the shop CTA stays punchy */
  @media (max-width: 749px) {
    #shopify-section-{{ section.id }} .pp__shop-suffix {
      display: none;
    }
  }
  #shopify-section-{{ section.id }} .pp__note {
    margin-top: var(--sp-4);
    color: rgb(var(--color-foreground) / 0.55);
  }
  #shopify-section-{{ section.id }} .pp__toast {
    position: absolute;
    inset-block-start: var(--sp-4);
    inset-inline: 0;
    margin-inline: auto;
    width: fit-content;
    background: #121e2a;
    color: #fff;
    padding: var(--sp-2) var(--sp-4);
    border-radius: var(--rounded-full);
    font-size: 0.85rem;
    opacity: 0;
    pointer-events: none;
  }
  @media (prefers-reduced-motion: no-preference) {
    #shopify-section-{{ section.id }} .pp__toast {
      transition: opacity 0.2s ease;
    }
  }
  #shopify-section-{{ section.id }} .pp__toast.is-show {
    opacity: 1;
  }

  /* Secondary button hover: solid midnight + white text (legibility) */
  @media (prefers-reduced-motion: no-preference) {
    #shopify-section-{{ section.id }} .button--secondary {
      transition: background-color var(--animation-primary), color var(--animation-primary), border-color var(--animation-primary);
    }
  }
  #shopify-section-{{ section.id }} .button--secondary:hover,
  #shopify-section-{{ section.id }} .button--secondary:focus-visible {
    background-color: #121e2a;
    color: #ffffff;
    border-color: #121e2a;
  }
  #shopify-section-{{ section.id }} .button--secondary:hover .btn-text,
  #shopify-section-{{ section.id }} .button--secondary:focus-visible .btn-text {
    color: #ffffff;
  }
</style>

<div class="section section--padding{% if section.settings.divider %} section--divider{% endif %}">
  <div class="page-width relative">
    <div class="pp" data-pp-root>

      {%- if section.settings.heading != blank -%}
        <h1 class="heading {{ section.settings.heading_size }}">{{ section.settings.heading }}</h1>
      {%- endif -%}
      {%- if section.settings.intro != blank -%}
        <div class="pp__intro text-lg rte">{{ section.settings.intro }}</div>
      {%- endif -%}

      <div class="pp__hud">
        <div class="pp__stat">Score <span data-pp-score>0</span></div>
        <div class="pp__lives" data-pp-lives aria-label="Shots remaining"></div>
        <div class="pp__stat">Best <span data-pp-best>0</span></div>
      </div>

      <div class="pp__streak" data-pp-streak aria-live="polite"></div>

      <div class="pp__stage" data-pp-stage tabindex="0">
        <canvas data-pp-canvas role="img" aria-label="Perfect Pour game. Stop the espresso pour when it reaches the green crema zone."></canvas>

        {%- comment -%} Start overlay {%- endcomment -%}
        <div class="pp__overlay" data-pp-start>
          <p class="heading title-md">Pull the perfect shot</p>
          <p class="text-base">Stop the pour when the espresso hits the green crema zone. Three ruined shots and you're out.</p>
          <button type="button" class="button button--primary" data-pp-play>
            <span class="btn-fill" data-fill></span>
            <span class="btn-text">{{ section.settings.play_label | default: 'Play' }}</span>
          </button>
        </div>

        {%- comment -%} Pause overlay {%- endcomment -%}
        <div class="pp__overlay" data-pp-pause hidden>
          <p class="heading title-md">Paused</p>
          <button type="button" class="button button--primary" data-pp-resume>
            <span class="btn-fill" data-fill></span>
            <span class="btn-text">Resume</span>
          </button>
        </div>

        {%- comment -%} Game over overlay {%- endcomment -%}
        <div class="pp__overlay" data-pp-over hidden>
          <p class="heading title-md">Nice pulls!</p>
          <p class="text-base">You scored <strong class="pp__score-big" data-pp-final>0</strong> points.<br><span data-pp-best-line></span></p>
          <div class="pp__actions">
            <button type="button" class="button button--primary" data-pp-again>
              <span class="btn-fill" data-fill></span>
              <span class="btn-text">Play again</span>
            </button>
            <button type="button" class="button button--secondary" data-pp-share>
              <span class="btn-fill" data-fill></span>
              <span class="btn-text">Share score</span>
            </button>
          </div>
          {%- if section.settings.shop_link != blank and section.settings.shop_label != blank -%}
            {%- assign shop_parts = section.settings.shop_label | split: '→' -%}
            <a class="button button--secondary pp__shop" href="{{ section.settings.shop_link }}">
              <span class="btn-fill" data-fill></span>
              <span class="btn-text">{{ shop_parts[0] | strip }}{%- if shop_parts.size > 1 -%}<span class="pp__shop-suffix"> → {{ shop_parts[1] | strip }}</span>{%- endif -%}</span>
            </a>
          {%- endif -%}
        </div>

        <div class="pp__toast" data-pp-toast aria-live="polite"></div>
      </div>

      <p class="pp__note text-sm" data-pp-note>Click or tap the glass (or press Space / Enter) to stop the pour. Press P to pause.</p>

    </div>
  </div>
</div>

<script>
  (function () {
    var root = document.getElementById('shopify-section-{{ section.id }}');
    if (!root) return;
    var canvas = root.querySelector('[data-pp-canvas]');
    var stage = root.querySelector('[data-pp-stage]');
    if (!canvas || !stage) return;
    var ctx = canvas.getContext('2d');

    var scoreEl = root.querySelector('[data-pp-score]');
    var bestEl = root.querySelector('[data-pp-best]');
    var livesEl = root.querySelector('[data-pp-lives]');
    var streakEl = root.querySelector('[data-pp-streak]');
    var startOv = root.querySelector('[data-pp-start]');
    var pauseOv = root.querySelector('[data-pp-pause]');
    var overOv = root.querySelector('[data-pp-over]');
    var finalEl = root.querySelector('[data-pp-final]');
    var bestLineEl = root.querySelector('[data-pp-best-line]');
    var toastEl = root.querySelector('[data-pp-toast]');
    var noteEl = root.querySelector('[data-pp-note]');

    var STORAGE_KEY = 'chefman-perfect-pour-hi';
    var best = 0;
    try { best = parseInt(localStorage.getItem(STORAGE_KEY) || '0', 10) || 0; } catch (e) {}
    if (bestEl) bestEl.textContent = best;

    var motionQuery = null;
    try { motionQuery = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)'); } catch (e) {}
    var reduceMotion = motionQuery ? motionQuery.matches : false;
    if (motionQuery) {
      var onMotionChange = function (e) { reduceMotion = e.matches; };
      if (motionQuery.addEventListener) motionQuery.addEventListener('change', onMotionChange);
      else if (motionQuery.addListener) motionQuery.addListener(onMotionChange);
    }

    /* ---- pixel buffer ----
       Like Melt Down and Bean Catcher: the game draws to a small offscreen
       buffer and scales up with smoothing off for the chunky-pixel look. */
    var GW = 162, GH = 216;
    var COUNTER_Y = GH - 28; // top of the tabletop
    var buffer = document.createElement('canvas');
    buffer.width = GW; buffer.height = GH;
    var b = buffer.getContext('2d');

    var dpr = Math.min(window.devicePixelRatio || 1, 2);
    var W = 0, H = 0;
    function resize() {
      var rect = stage.getBoundingClientRect();
      W = rect.width; H = rect.height;
      canvas.width = Math.round(W * dpr);
      canvas.height = Math.round(H * dpr);
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      ctx.imageSmoothingEnabled = false;
    }
    function blit() {
      ctx.clearRect(0, 0, W, H);
      ctx.imageSmoothingEnabled = false;
      ctx.drawImage(buffer, 0, 0, GW, GH, 0, 0, W, H);
    }

    /* ---- tunable constants ---- */
    var BAND_MAX = 0.22;        // band height (fraction of glass) at score 0
    var BAND_MIN = 0.08;        // smallest band height at high score
    var BAND_SHRINK = 0.0009;   // how fast the band shrinks per point
    var SPEED_BASE = 0.34;      // fill rises 0->1 over ~1/SPEED of a second at score 0 (fraction per second)
    var SPEED_GAIN = 0.0022;    // fill speed increase per point
    var SPEED_MAX = 0.95;       // cap on fill fraction per second
    var BAND_LOW = 0.18;        // lowest possible band center (near bottom of glass)
    var BAND_HIGH = 0.86;       // highest possible band center (near top of glass)
    var FEEDBACK_MS = 800;      // pause between a result and the next pour
    var PERFECT_THRESHOLD = 0.85;

    /* ---- game state ---- */
    var state = 'idle'; // idle | playing | resolving | paused | over
    var score = 0, lives = 3, streak = 0;
    var fill = 0;          // 0..1 current pour level
    var bandH = BAND_MAX;  // current band height (fraction)
    var bandCenter = 0.5;  // current band center (fraction)
    var lastTime = 0, rafId = null, hitTimer = null, goodTimer = null, resolveTimer = null;
    var lastResult = null; // { ok, label, accuracy }
    var pendingPour = false; // a next pour was queued (resolving) when we paused

    function bandHeight() {
      return Math.max(BAND_MIN, BAND_MAX - score * BAND_SHRINK);
    }
    function fillSpeed() {
      return Math.min(SPEED_MAX, SPEED_BASE + score * SPEED_GAIN);
    }

    function newPour() {
      bandH = bandHeight();
      var half = bandH / 2;
      bandCenter = BAND_LOW + half + Math.random() * (BAND_HIGH - BAND_LOW - bandH);
      fill = 0;
      lastResult = null;
      state = 'playing';
      lastTime = performance.now();
      cancelAnimationFrame(rafId);
      rafId = requestAnimationFrame(step);
    }

    function reset() {
      score = 0; lives = 3; streak = 0; fill = 0;
      bandH = BAND_MAX; bandCenter = 0.5;
      pendingPour = false;
      clearTimeout(hitTimer);
      clearTimeout(goodTimer);
      clearTimeout(resolveTimer);
      clearTimeout(streakTimer);
      clearTimeout(toastTimer);
      stage.classList.remove('is-hit');
      stage.classList.remove('is-good');
      hideStreak();
      if (toastEl) { toastEl.classList.remove('is-show'); toastEl.textContent = ''; }
      updateHud();
    }

    function updateHud() {
      if (scoreEl) scoreEl.textContent = score;
      if (livesEl) {
        var s = '';
        for (var i = 0; i < 3; i++) {
          s += '<span class="pp__life' + (i >= lives ? ' pp__life--lost' : '') + '" aria-hidden="true">☕</span>';
        }
        livesEl.innerHTML = s;
        livesEl.setAttribute('aria-label', lives + ' of 3 shots remaining');
      }
    }

    /* ---- evaluation ---- */
    function stopPour() {
      if (state !== 'playing') return;
      cancelAnimationFrame(rafId);
      var low = bandCenter - bandH / 2;
      var high = bandCenter + bandH / 2;
      if (fill >= low && fill <= high) {
        var accuracy = Math.max(0, Math.min(1, 1 - Math.abs(fill - bandCenter) / (bandH / 2)));
        var points = Math.round(20 + accuracy * 80);
        score += points;
        streak += 1;
        var label = accuracy >= PERFECT_THRESHOLD ? 'Perfect shot!' : 'Good pour';
        lastResult = { ok: true, label: label, accuracy: accuracy, points: points };
        updateHud();
        flashGood();
        showStreak(label + ' +' + points + (streak > 1 ? '  ·  streak ' + streak : ''));
        scheduleNext();
      } else {
        // missed the band — stopped too early (under) or too late (over)
        var early = fill < low;
        lives -= 1;
        streak = 0;
        lastResult = { ok: false, label: early ? 'Under-extracted' : 'Over-extracted', accuracy: 0, points: 0 };
        updateHud();
        flashHit();
        showStreak(early ? 'Under-extracted — stopped too soon' : 'Over-extracted — stopped too late');
        if (lives <= 0) { state = 'resolving'; render(); resolveTimer = setTimeout(gameOver, FEEDBACK_MS); }
        else scheduleNext();
      }
    }

    function overflow() {
      // fill reached the top before the player stopped
      cancelAnimationFrame(rafId);
      lives -= 1;
      streak = 0;
      lastResult = { ok: false, label: 'Over-extracted', accuracy: 0, points: 0 };
      updateHud();
      flashHit();
      showStreak('Over-extracted — it overflowed');
      if (lives <= 0) { state = 'resolving'; render(); resolveTimer = setTimeout(gameOver, FEEDBACK_MS); }
      else scheduleNext();
    }

    function scheduleNext() {
      state = 'resolving';
      render();
      clearTimeout(resolveTimer);
      resolveTimer = setTimeout(function () {
        if (state !== 'resolving') return;
        newPour();
      }, FEEDBACK_MS);
    }

    /* ---- geometry of the glass (buffer px) ---- */
    // Base sits on the tabletop; the area above is for the stream + score.
    var GLASS = { left: 46, top: 72, w: 70, h: 118 };

    /* ---- drawing ---- */
    // Flat wall + wood tabletop, same palette as Bean Catcher.
    function drawScene() {
      b.fillStyle = '#f1e3c9';
      b.fillRect(0, 0, GW, GH);
      b.fillStyle = '#6f4e37'; b.fillRect(0, COUNTER_Y, GW, GH - COUNTER_Y);
      b.fillStyle = '#8a6650'; b.fillRect(0, COUNTER_Y, GW, 2);
      b.fillStyle = '#4a3324'; b.fillRect(0, GH - 4, GW, 4);
      b.fillStyle = '#5f4128';
      for (var g = 8; g < GW; g += 26) b.fillRect(g, COUNTER_Y + 8, 12, 1);
    }

    // Top-center pixel score, same 3x5 font as Melt Down / Bean Catcher.
    var DIGITS = [
      ['111','101','101','101','111'],
      ['010','110','010','010','111'],
      ['111','001','111','100','111'],
      ['111','001','111','001','111'],
      ['101','101','111','001','001'],
      ['111','100','111','001','111'],
      ['111','100','111','101','111'],
      ['111','001','001','010','010'],
      ['111','101','111','101','111'],
      ['111','101','111','001','111']
    ];
    function drawDigit(d, x, y, px, color) {
      var map = DIGITS[d];
      b.fillStyle = color;
      for (var r = 0; r < 5; r++) {
        for (var c = 0; c < 3; c++) {
          if (map[r].charAt(c) === '1') b.fillRect(x + c * px, y + r * px, px, px);
        }
      }
    }
    function drawScore() {
      var str = String(score);
      var px = 2;
      var gw = 3 * px, sp = px;
      var total = str.length * gw + (str.length - 1) * sp;
      var x0 = Math.round((GW - total) / 2);
      var y0 = 10;
      var i, d, x;
      for (i = 0; i < str.length; i++) {
        d = str.charCodeAt(i) - 48;
        x = x0 + i * (gw + sp);
        drawDigit(d, x - 1, y0, px, '#3a2b23');
        drawDigit(d, x + 1, y0, px, '#3a2b23');
        drawDigit(d, x, y0 - 1, px, '#3a2b23');
        drawDigit(d, x, y0 + 1, px, '#3a2b23');
      }
      for (i = 0; i < str.length; i++) {
        d = str.charCodeAt(i) - 48;
        drawDigit(d, x0 + i * (gw + sp), y0, px, '#ffffff');
      }
    }

    function render() {
      drawScene();
      var g = GLASS;
      var inL = g.left + 2, inW = g.w - 4;
      var inTop = g.top + 2, inH = g.h - 4, inBot = g.top + g.h - 2;
      var fillTopY = Math.round(inBot - fill * inH);

      // shadow on the tabletop
      b.fillStyle = 'rgba(58,36,21,0.45)';
      b.fillRect(g.left + 3, g.top + g.h - 1, g.w - 6, 2);

      // glass interior
      b.fillStyle = '#faf3e3';
      b.fillRect(inL, inTop, inW, inH);

      // espresso
      if (fill > 0) {
        b.fillStyle = '#3e2b20';
        b.fillRect(inL, fillTopY, inW, inBot - fillTopY);
        b.fillStyle = '#5a3f2d';
        b.fillRect(inL, fillTopY, inW, Math.min(8, inBot - fillTopY));
        // crema cap
        b.fillStyle = '#c79a6b';
        b.fillRect(inL, fillTopY, inW, Math.min(4, inBot - fillTopY));
        b.fillStyle = '#e3bd8e';
        b.fillRect(inL, fillTopY, inW, 1);
      }

      // crema target band — tint only the unfilled part so the espresso keeps
      // its color as it rises into the zone; the edge lines stay on top
      var bandTopY = Math.round(inBot - (bandCenter + bandH / 2) * inH);
      var bandBotY = Math.round(inBot - (bandCenter - bandH / 2) * inH);
      var tintBot = Math.min(bandBotY, fillTopY);
      if (tintBot > bandTopY) {
        b.fillStyle = 'rgba(46,160,90,0.22)';
        b.fillRect(inL, bandTopY, inW, tintBot - bandTopY);
      }
      b.fillStyle = '#2ea05a';
      b.fillRect(inL, bandTopY, inW, 1);
      b.fillRect(inL, bandBotY - 1, inW, 1);

      // glass shine (left inner edge)
      b.fillStyle = 'rgba(255,255,255,0.5)';
      b.fillRect(inL + 2, inTop + 4, 2, inH - 12);

      // blocky outline + right handle, matching the Bean Catcher mug language
      b.fillStyle = '#15191d';
      b.fillRect(g.left, g.top, g.w, 2);
      b.fillRect(g.left, g.top + g.h - 2, g.w, 2);
      b.fillRect(g.left, g.top, 2, g.h);
      b.fillRect(g.left + g.w - 2, g.top, 2, g.h);
      var hx = g.left + g.w - 1, hy = g.top + 30;
      b.fillRect(hx, hy, 15, 5);
      b.fillRect(hx + 11, hy, 4, 48);
      b.fillRect(hx, hy + 43, 15, 5);

      // pour stream — from the top edge down to the espresso surface
      if (state === 'playing' && fill < 1) {
        var sx = Math.round(GW / 2) - 2;
        b.fillStyle = '#3e2b20';
        b.fillRect(sx, 0, 4, fillTopY);
        b.fillStyle = '#6f4e37';
        b.fillRect(sx + 1, 0, 2, fillTopY);
      }

      drawScore();
      blit();
    }

    /* ---- loop ---- */
    function step(now) {
      if (state !== 'playing') return;
      var dt = Math.min(0.05, (now - lastTime) / 1000 || 0);
      lastTime = now;

      fill += fillSpeed() * dt;
      if (fill >= 1) {
        fill = 1;
        render();
        overflow();
        return;
      }
      render();
      rafId = requestAnimationFrame(step);
    }

    /* ---- state transitions ---- */
    function startGame() {
      reset();
      hide(startOv); hide(pauseOv); hide(overOv); hide(noteEl);
      try { stage.focus({ preventScroll: true }); } catch (e) { stage.focus(); }
      newPour();
    }
    function pauseGame() {
      if (state !== 'playing' && state !== 'resolving') return;
      // If we're in the feedback gap, defer the queued pour until resume so it
      // doesn't silently start (and possibly overflow) while paused / off-tab.
      if (state === 'resolving') {
        pendingPour = true;
        clearTimeout(resolveTimer);
      }
      state = 'paused';
      cancelAnimationFrame(rafId);
      show(pauseOv);
    }
    function resumeGame() {
      if (state !== 'paused') return;
      hide(pauseOv);
      try { stage.focus({ preventScroll: true }); } catch (e) { stage.focus(); }
      if (pendingPour) {
        pendingPour = false;
        newPour();
        return;
      }
      state = 'playing';
      lastTime = performance.now();
      rafId = requestAnimationFrame(step);
    }
    function gameOver() {
      state = 'over';
      cancelAnimationFrame(rafId);
      clearTimeout(resolveTimer);
      render();
      hideStreak();
      if (finalEl) finalEl.textContent = score;
      var isRecord = score > best;
      if (isRecord) {
        best = score;
        try { localStorage.setItem(STORAGE_KEY, String(best)); } catch (e) {}
        if (bestEl) bestEl.textContent = best;
      }
      if (bestLineEl) bestLineEl.textContent = isRecord ? 'New personal best! 🎉' : 'Your best: ' + best;
      show(overOv);
      show(noteEl);
    }

    function show(el) { if (el) el.hidden = false; }
    function hide(el) { if (el) el.hidden = true; }

    function flashHit() {
      if (reduceMotion) return;
      stage.classList.remove('is-good');
      clearTimeout(goodTimer);
      stage.classList.remove('is-hit');
      void stage.offsetWidth; // reflow to restart the animation
      stage.classList.add('is-hit');
      clearTimeout(hitTimer);
      hitTimer = setTimeout(function () { stage.classList.remove('is-hit'); }, 800);
    }
    function flashGood() {
      if (reduceMotion) return;
      stage.classList.remove('is-hit');
      clearTimeout(hitTimer);
      stage.classList.remove('is-good');
      void stage.offsetWidth;
      stage.classList.add('is-good');
      clearTimeout(goodTimer);
      goodTimer = setTimeout(function () { stage.classList.remove('is-good'); }, 800);
    }

    var streakTimer = null;
    function showStreak(msg) {
      if (!streakEl) return;
      streakEl.textContent = msg;
      streakEl.classList.add('is-show');
      clearTimeout(streakTimer);
      streakTimer = setTimeout(function () { streakEl.classList.remove('is-show'); }, 1400);
    }
    function hideStreak() {
      if (!streakEl) return;
      streakEl.classList.remove('is-show');
      streakEl.textContent = '';
    }

    var toastTimer = null;
    function toast(msg) {
      if (!toastEl) return;
      toastEl.textContent = msg;
      toastEl.classList.add('is-show');
      clearTimeout(toastTimer);
      toastTimer = setTimeout(function () { toastEl.classList.remove('is-show'); }, 1600);
    }

    // Legacy clipboard fallback for contexts without navigator.clipboard.
    function legacyCopy(str) {
      try {
        var ta = document.createElement('textarea');
        ta.value = str;
        ta.setAttribute('readonly', '');
        ta.style.position = 'fixed';
        ta.style.opacity = '0';
        document.body.appendChild(ta);
        ta.select();
        var ok = document.execCommand('copy');
        document.body.removeChild(ta);
        return ok;
      } catch (e) { return false; }
    }

    function share() {
      var text = 'I scored ' + score + ' in Chefman Perfect Pour! ☕';
      var url = location.href;
      var payload = text + ' ' + url;
      // Always try to copy to the clipboard and confirm, so every click gives feedback.
      var onCopied = function () { toast('Copied to clipboard! ☕'); };
      var onFailed = function () { toast(legacyCopy(payload) ? 'Copied to clipboard! ☕' : text); };
      if (navigator.clipboard && navigator.clipboard.writeText) {
        navigator.clipboard.writeText(payload).then(onCopied, onFailed);
      } else {
        onFailed();
      }
      // Also open the native share sheet where supported (mostly mobile / Safari).
      // It's blocked in the theme-editor preview iframe, but works on the live site.
      if (navigator.share) {
        navigator.share({ title: 'Chefman Perfect Pour', text: text, url: url }).catch(function () {});
      }
    }

    /* ---- input ---- */
    // Tap / click anywhere on the play area stops the pour. Touch and click both
    // route here; the click handler guards against touch-synthesized clicks.
    var lastTouchTime = 0;
    canvas.addEventListener('touchstart', function (e) {
      lastTouchTime = performance.now();
      if (state === 'playing') {
        if (e.cancelable) e.preventDefault();
        stopPour();
      }
    }, { passive: false });
    canvas.addEventListener('click', function () {
      if (performance.now() - lastTouchTime < 600) return;
      if (state === 'playing') stopPour();
    });
    // Click anywhere on the pause overlay to resume (Resume button still works too).
    if (pauseOv) pauseOv.addEventListener('click', function () { resumeGame(); });

    window.addEventListener('keydown', function (e) {
      // Don't hijack typing or other page widgets: only react when the game has
      // keyboard focus and the target isn't an editable / form control.
      var t = e.target;
      if (t && (t.isContentEditable || /^(INPUT|TEXTAREA|SELECT)$/.test(t.tagName))) return;
      if (!root.contains(document.activeElement)) return;

      if (e.key === ' ' || e.key === 'Spacebar') {
        // Only intercept Space while actively pouring; otherwise let it activate
        // a focused button (Play / Resume / Play again) normally.
        if (state === 'playing') { if (e.cancelable) e.preventDefault(); stopPour(); }
      } else if (e.key === 'Enter') {
        // Keep Enter limited to the playing state so it can still activate
        // focused buttons in the overlays.
        if (state === 'playing') { if (e.cancelable) e.preventDefault(); stopPour(); }
      } else if (e.key === 'p' || e.key === 'P') {
        if (state === 'playing' || state === 'resolving') pauseGame();
        else if (state === 'paused') resumeGame();
      }
    });

    document.addEventListener('visibilitychange', function () {
      if (document.hidden) pauseGame();
    });

    root.querySelector('[data-pp-play]').addEventListener('click', startGame);
    root.querySelector('[data-pp-again]').addEventListener('click', startGame);
    root.querySelector('[data-pp-resume]').addEventListener('click', resumeGame);
    var shareBtn = root.querySelector('[data-pp-share]');
    if (shareBtn) shareBtn.addEventListener('click', share);

    var resizeRaf = null;
    window.addEventListener('resize', function () {
      cancelAnimationFrame(resizeRaf);
      resizeRaf = requestAnimationFrame(function () {
        resize();
        if (state !== 'playing') render();
      });
    });

    /* ---- init ---- */
    resize();
    updateHud();
    render();
  })();
</script>

