{
  "name": "t:sections.overlay-group.name",
  "type": "custom.overlay",
  "sections": {
    "cart-drawer": {
      "type": "cart-drawer",
      "settings": {
        "show_vendor": false,
        "show_cart_note": false,
        "show_shipping_calculator": false,
        "show_view_cart_button": true,
        "show_checkout_button": true,
        "show_free_shipping_bar": false,
        "free_shipping_minimum_amount": "",
        "cart_recommendations_enabled": false,
        "cart_recommendations_heading": "Vous aimerez peut-être aussi",
        "cart_recommendations_limit": 5,
        "show_cart_recommendations_vendor": false,
        "show_cart_recommendations_price": true,
        "cart_recommendations_products": [],
        "empty_cart_message": "<p>Vous ne savez pas par où commencer?<br/>Essayez ces collections :</p>",
        "empty_cart_collections": [
          "air-fryers-1",
          "coffee-espresso-makers",
          "kettles-2",
          "performance-series"
        ],
        "recent_products_enabled": true,
        "recent_products_heading": "Recently viewed",
        "recent_products_limit": 5,
        "show_recent_products_vendor": false,
        "show_recent_products_price": true
      }
    },
    "search-drawer": {
      "type": "search-drawer",
      "settings": {}
    },
    "newsletter-popup": {
      "type": "newsletter-popup",
      "blocks": {
        "text-1": {
          "type": "text",
          "settings": {
            "text": "<p>PREMIÈRE FOIS?</p>",
            "text_size": "subtext-custom",
            "text_max_size": 12,
            "text_font": "body",
            "secondary_color": true,
            "highlighted_text": "none",
            "highlighted_scribble": "circle"
          }
        },
        "heading": {
          "type": "heading",
          "settings": {
            "heading": "Inscrivez-vous et obtenez <em>20 % de rabais</em> sur votre première commande",
            "heading_size": "text-2xl lg:text-3xl",
            "heading_tag": "h2",
            "highlighted_text": "scribble",
            "highlighted_scribble": "basic-underline"
          }
        },
        "spacing": {
          "type": "spacing",
          "settings": {
            "height": 32,
            "height_mobile": 12
          }
        },
        "form": {
          "type": "form",
          "settings": {}
        },
        "text-2": {
          "type": "text",
          "settings": {
            "text": "<p>Abonnez-vous à notre infolettre et soyez le premier à être informé de nos nouveautés, de nos promotions spéciales et de nos exclusivités en ligne.</p>",
            "text_size": "text-sm",
            "text_max_size": 32,
            "text_font": "body",
            "secondary_color": true,
            "highlighted_text": "none",
            "highlighted_scribble": "circle"
          }
        },
        "media": {
          "type": "media",
          "settings": {}
        },
        "floating": {
          "type": "floating",
          "settings": {
            "heading": "Obtenez 20 % de rabais",
            "content_position": "left-0",
            "show_social": true,
            "social_heading": "Suivez-nous",
            "mobile_disabled": true,
            "mobile_hide_social": false,
            "color_text": "#171717",
            "color_background": "#ffffff"
          }
        }
      },
      "block_order": [
        "text-1",
        "heading",
        "spacing",
        "form",
        "text-2",
        "media",
        "floating"
      ],
      "disabled": true,
      "settings": {
        "mode": "enabled",
        "only_homepage": true,
        "only_visitor": true,
        "delay": 7,
        "expiry": 30,
        "text_alignment": "left",
        "content_position": "right-0",
        "color_drawer_text": "#171717",
        "color_drawer_background": "#ffffff",
        "color_drawer_highlight": "#ffddbf",
        "color_drawer_button_text": "#ffffff",
        "color_drawer_button_background": "#171717",
        "color_drawer_button_gradient": "",
        "color_drawer_overlay": "#171717"
      }
    },
    "age-verifier": {
      "type": "age-verifier",
      "blocks": {
        "heading": {
          "type": "heading",
          "settings": {
            "heading": "Confirmez votre âge",
            "heading_size": "text-lg-2xl",
            "heading_tag": "h2",
            "highlighted_text": "none",
            "highlighted_scribble": "circle"
          }
        },
        "text": {
          "type": "text",
          "settings": {
            "text": "<p>Avez-vous 18 ans ou plus?</p>",
            "text_size": "text-base",
            "text_max_size": 32,
            "text_font": "body",
            "secondary_color": false,
            "highlighted_text": "none",
            "highlighted_scribble": "circle"
          }
        },
        "spacing": {
          "type": "spacing",
          "settings": {
            "height": 16,
            "height_mobile": 12
          }
        },
        "buttons": {
          "type": "buttons",
          "settings": {
            "button_label_1": "Oui, je le suis",
            "button_label_2": "Non, je ne le suis pas",
            "button_link_2": "",
            "button_external_2": false
          }
        }
      },
      "block_order": [
        "heading",
        "text",
        "spacing",
        "buttons"
      ],
      "disabled": true,
      "settings": {
        "mode": "enabled",
        "expiry": 30,
        "text_alignment": "center",
        "content_position": "center-0",
        "blur_background_image": false,
        "color_drawer_text": "#171717",
        "color_drawer_background": "#ffffff",
        "color_drawer_highlight": "#ffddbf",
        "color_drawer_button_text": "#ffffff",
        "color_drawer_button_background": "#171717",
        "color_drawer_button_gradient": "",
        "color_drawer_overlay": "#171717"
      }
    },
    "cookie-banner": {
      "type": "cookie-banner",
      "blocks": {
        "heading": {
          "type": "heading",
          "settings": {
            "heading": "Nous utilisons des témoins",
            "heading_size": "text-lg-2xl",
            "heading_tag": "h2",
            "highlighted_text": "none",
            "highlighted_scribble": "circle"
          }
        },
        "text": {
          "type": "text",
          "settings": {
            "text": "<p>Ce site utilise des témoins pour améliorer l'expérience utilisateur et les analyses.</p>",
            "text_size": "text-base",
            "text_max_size": 32,
            "text_font": "body",
            "secondary_color": false,
            "highlighted_text": "none",
            "highlighted_scribble": "circle"
          }
        },
        "spacing": {
          "type": "spacing",
          "settings": {
            "height": 16,
            "height_mobile": 12
          }
        },
        "buttons": {
          "type": "buttons",
          "settings": {
            "button_label_1": "Accepter",
            "button_label_2": "Refuser"
          }
        }
      },
      "block_order": [
        "heading",
        "text",
        "spacing",
        "buttons"
      ],
      "disabled": true,
      "custom_css": [
        ".cookie-banner {}"
      ],
      "settings": {
        "mode": "enabled",
        "delay": 5,
        "text_alignment": "center",
        "content_position": "right-0",
        "color_drawer_text": "#171717",
        "color_drawer_background": "#ffffff",
        "color_drawer_highlight": "#ffddbf",
        "color_drawer_button_text": "#ffffff",
        "color_drawer_button_background": "#171717",
        "color_drawer_button_gradient": ""
      }
    },
    "mobile-dock": {
      "type": "mobile-dock",
      "blocks": {
        "mobile-dock-1": {
          "type": "home",
          "settings": {
            "custom_icon": "",
            "title": "Accueil"
          }
        },
        "mobile-dock-2": {
          "type": "menu",
          "settings": {
            "custom_icon": "",
            "title": "Menu"
          }
        },
        "mobile-dock-3": {
          "type": "search",
          "settings": {
            "custom_icon": "",
            "title": "Rechercher"
          }
        },
        "mobile-dock-4": {
          "type": "link",
          "settings": {
            "custom_icon": "",
            "title": "Magasiner",
            "link": "shopify://collections/all",
            "external": false
          }
        },
        "mobile-dock-5": {
          "type": "cart",
          "settings": {
            "custom_icon": "",
            "title": "Panier"
          }
        },
        "mobile-dock-6": {
          "type": "account",
          "settings": {
            "custom_icon": "",
            "title": "Compte"
          }
        }
      },
      "block_order": [
        "mobile-dock-1",
        "mobile-dock-2",
        "mobile-dock-3",
        "mobile-dock-4",
        "mobile-dock-5",
        "mobile-dock-6"
      ],
      "disabled": true,
      "settings": {
        "color_text": "#000000",
        "color_background": "#ffffff",
        "gradient_background": "",
        "padding_top": 8,
        "padding_bottom": 8,
        "divider": true,
        "rounded": true
      }
    }
  },
  "order": [
    "cart-drawer",
    "search-drawer",
    "newsletter-popup",
    "age-verifier",
    "cookie-banner",
    "mobile-dock"
  ]
}