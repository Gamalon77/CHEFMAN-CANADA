{% assign carousel_id = section.id | replace: '_', '' | downcase %}

{% style %}
.ai-product-carousel-{{ carousel_id }} {
  display: block;
  width: 100%;
  padding: {{ section.settings.section_padding }}px 0;
  background-color: {{ section.settings.background_color }};
}

.ai-product-carousel__container-{{ carousel_id }} {
  max-width: {{ section.settings.container_width }}px;
  margin: 0 auto;
  padding: 0 20px;
}

.ai-product-carousel__track-{{ carousel_id }} {
  display: flex;
  gap: {{ section.settings.product_gap }}px;
  overflow-x: auto;
  scroll-behavior: smooth;
  scrollbar-width: none;
}

.ai-product-carousel__track-{{ carousel_id }}::-webkit-scrollbar {
  display: none;
}

.ai-product-carousel__item-{{ carousel_id }} {
  flex: 0 0 calc((100% - ({{ section.settings.products_per_row_desktop | minus: 1 }} * {{ section.settings.product_gap }}px)) / {{ section.settings.products_per_row_desktop }});
}

.ai-product-carousel__card-{{ carousel_id }} {
  background: {{ section.settings.card_background }};
  border-radius: {{ section.settings.card_border_radius }}px;
  overflow: hidden;
  display: flex;
  flex-direction: column;
}

.ai-product-carousel__image-wrapper-{{ carousel_id }} {
  position: relative;
  padding-bottom: 100%;
}

.ai-product-carousel__image-{{ carousel_id }} {
  position: absolute;
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.ai-product-carousel__content-{{ carousel_id }} {
  padding: 15px;
  flex-grow: 1;
}

.ai-product-carousel__button-{{ carousel_id }} {
  margin-top: auto;
  display: block;
  text-align: center;
  background: {{ section.settings.button_background }};
  color: {{ section.settings.button_text_color }};
  padding: 12px;
  border-radius: {{ section.settings.button_border_radius }}px;
}
{% endstyle %}

<section class="ai-product-carousel-{{ carousel_id }}">
  <div class="ai-product-carousel__container-{{ carousel_id }}">

    {% if section.settings.heading != blank %}
      <h2>{{ section.settings.heading }}</h2>
    {% endif %}

    {% assign products = section.settings.products %}

    {% if products != blank %}
      <div class="ai-product-carousel__track-{{ carousel_id }}">
        {% for product in products %}
          <div class="ai-product-carousel__item-{{ carousel_id }}">
            <div class="ai-product-carousel__card-{{ carousel_id }}">

              <div class="ai-product-carousel__image-wrapper-{{ carousel_id }}">
                {% if product.featured_image %}
                  <img
                    src="{{ product.featured_image | image_url: width: 600 }}"
                    alt="{{ product.featured_image.alt | escape }}"
                    loading="lazy"
                    class="ai-product-carousel__image-{{ carousel_id }}"
                  >
                {% endif %}
              </div>

              <div class="ai-product-carousel__content-{{ carousel_id }}">
                <h3>{{ product.title }}</h3>

                {% if section.settings.show_price %}
                  {{ product.price | money }}
                {% endif %}

                <a href="{{ product.url }}" class="ai-product-carousel__button-{{ carousel_id }}">
                  {{ section.settings.button_text }}
                </a>
              </div>

            </div>
          </div>
        {% endfor %}
      </div>
    {% endif %}

  </div>
</section>

<script>
class ProductCarousel{{ carousel_id }} extends HTMLElement {
  connectedCallback() {
    this.track = this.querySelector('.ai-product-carousel__track-{{ carousel_id }}');
  }
}
customElements.define('product-carousel-{{ carousel_id }}', ProductCarousel{{ carousel_id }});
</script>

{% schema %}
{
  "name": "Product carousel",
  "settings": [
    {
      "type": "product_list",
      "id": "products",
      "label": "Carousel products",
      "limit": 6
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "You may also like"
    },
    {
      "type": "checkbox",
      "id": "show_price",
      "label": "Show price",
      "default": true
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button text",
      "default": "View product"
    },
    {
      "type": "range",
      "id": "products_per_row_desktop",
      "min": 2,
      "max": 6,
      "step": 1,
      "label": "Products per row (desktop)",
      "default": 3
    },
    {
      "type": "range",
      "id": "product_gap",
      "min": 10,
      "max": 40,
      "step": 5,
      "unit": "px",
      "label": "Gap between products",
      "default": 20
    }
  ],
  "presets": [
    {
      "name": "Product carousel"
    }
  ]
}
{% endschema %}
