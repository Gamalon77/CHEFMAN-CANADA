<style>
  #shopify-section-{{ section.id }} {
    --section-padding-top: {{ section.settings.padding_top }}px;
    --section-padding-bottom: {{ section.settings.padding_bottom }}px;
    --kd-ink: 18 30 42;
    --kd-r-card: 24px;
    --kd-r-tile: 16px;
    --kd-r-pill: 999px;
    {%- render 'section-variables', section: section -%}
  }

  /* Breadcrumb */
  #shopify-section-{{ section.id }} .kd-breadcrumb { margin-bottom: var(--sp-8); }
  #shopify-section-{{ section.id }} .kd-breadcrumb__list { display: flex; flex-wrap: wrap; align-items: center; gap: var(--sp-2); list-style: none; margin: 0; padding: 0; color: rgb(var(--color-foreground) / 0.6); }
  #shopify-section-{{ section.id }} .kd-breadcrumb__item { display: inline-flex; align-items: center; }
  #shopify-section-{{ section.id }} .kd-breadcrumb__link { color: inherit; text-decoration: none; }
  #shopify-section-{{ section.id }} .kd-breadcrumb__link:hover { color: rgb(var(--kd-ink)); }
  #shopify-section-{{ section.id }} .kd-breadcrumb__item--current { color: rgb(var(--kd-ink)); font-weight: 600; }

  /* Hero */
  #shopify-section-{{ section.id }} .kd-hero { display: grid; gap: var(--sp-8); align-items: center; grid-template-columns: 1fr; }
  @media (min-width: 750px) { #shopify-section-{{ section.id }} .kd-hero--media { grid-template-columns: 1.1fr 0.9fr; } }
  #shopify-section-{{ section.id }} .kd-eyebrow { display: inline-block; margin-bottom: var(--sp-3); padding: 0.35rem 0.9rem; border-radius: var(--kd-r-pill); background: rgb(var(--kd-ink) / 0.08); color: rgb(var(--kd-ink)); font-size: 0.8rem; font-weight: 600; letter-spacing: 0.04em; text-transform: uppercase; }
  #shopify-section-{{ section.id }} .kd-hero__intro { margin-top: var(--sp-4); color: rgb(var(--color-foreground) / 0.78); font-size: 1.05rem; }
  #shopify-section-{{ section.id }} .kd-hero__bestfor { margin-top: var(--sp-4); font-size: 0.8rem; font-weight: 700; letter-spacing: 0.03em; text-transform: uppercase; color: rgb(var(--kd-ink) / 0.75); }
  #shopify-section-{{ section.id }} .kd-hero__media img { width: 100%; height: 100%; object-fit: cover; border-radius: var(--kd-r-card); display: block; }

  /* Generic block */
  #shopify-section-{{ section.id }} .kd-block { margin-top: var(--sp-14); }
  #shopify-section-{{ section.id }} .kd-block__head { max-width: 52rem; margin-bottom: var(--sp-6); }
  #shopify-section-{{ section.id }} .kd-block--center .kd-block__head { margin-inline: auto; text-align: center; }
  #shopify-section-{{ section.id }} .kd-prose { max-width: 52rem; color: rgb(var(--color-foreground) / 0.8); line-height: 1.7; }

  /* Why (reasons) */
  #shopify-section-{{ section.id }} .kd-reasons { display: grid; gap: var(--sp-4); grid-template-columns: 1fr; }
  @media (min-width: 750px) { #shopify-section-{{ section.id }} .kd-reasons { grid-template-columns: repeat(2, 1fr); } }
  #shopify-section-{{ section.id }} .kd-reason { padding: var(--sp-5); border: 1px solid rgb(var(--color-border)); border-radius: var(--kd-r-tile); }
  #shopify-section-{{ section.id }} .kd-reason__title { font-weight: 700; margin-bottom: var(--sp-1); color: rgb(var(--kd-ink)); }
  #shopify-section-{{ section.id }} .kd-reason__text { color: rgb(var(--color-foreground) / 0.75); font-size: 0.92rem; }

  /* Features */
  #shopify-section-{{ section.id }} .kd-features { display: grid; gap: var(--sp-5); grid-template-columns: 1fr; }
  @media (min-width: 750px) { #shopify-section-{{ section.id }} .kd-features { grid-template-columns: repeat(3, 1fr); } }
  #shopify-section-{{ section.id }} .kd-feature { text-align: center; padding: var(--sp-5) var(--sp-3); border: 1px solid rgb(var(--color-border)); border-radius: var(--kd-r-tile); background: rgb(var(--color-background)); }
  #shopify-section-{{ section.id }} .kd-feature__icon { font-size: 1.8rem; line-height: 1; }
  #shopify-section-{{ section.id }} .kd-feature__title { margin: var(--sp-3) 0 var(--sp-1); font-weight: 700; }
  #shopify-section-{{ section.id }} .kd-feature__text { color: rgb(var(--color-foreground) / 0.72); font-size: 0.88rem; }

  /* Good to know */
  #shopify-section-{{ section.id }} .kd-notes { display: grid; gap: var(--sp-4); grid-template-columns: 1fr; max-width: 52rem; }
  @media (min-width: 750px) { #shopify-section-{{ section.id }} .kd-notes { grid-template-columns: repeat(2, 1fr); } }
  #shopify-section-{{ section.id }} .kd-note { padding: var(--sp-4) var(--sp-5); border-left: 3px solid rgb(var(--kd-ink) / 0.55); background: rgb(var(--kd-ink) / 0.04); border-radius: 0 var(--kd-r-tile) var(--kd-r-tile) 0; }
  #shopify-section-{{ section.id }} .kd-note__title { font-weight: 700; margin-bottom: 2px; color: rgb(var(--kd-ink)); }
  #shopify-section-{{ section.id }} .kd-note__text { color: rgb(var(--color-foreground) / 0.78); font-size: 0.9rem; }

  /* Shop */
  #shopify-section-{{ section.id }} .kd-shop__cta { text-align: center; margin-top: var(--sp-8); }

  /* Related */
  #shopify-section-{{ section.id }} .kd-related { display: flex; flex-wrap: wrap; gap: var(--sp-3); }
  #shopify-section-{{ section.id }} .kd-related__link { display: inline-flex; align-items: center; gap: 0.4rem; padding: 0.6rem 1.1rem; border: 1px solid rgb(var(--color-border)); border-radius: var(--kd-r-pill); text-decoration: none; color: rgb(var(--kd-ink)); font-weight: 600; font-size: 0.9rem; }
  @media (prefers-reduced-motion: no-preference) { #shopify-section-{{ section.id }} .kd-related__link { transition: border-color 0.2s ease, background-color 0.2s ease; } }
  #shopify-section-{{ section.id }} .kd-related__link:hover { border-color: rgb(var(--kd-ink)); background: rgb(var(--kd-ink) / 0.05); }

  /* FAQ */
  #shopify-section-{{ section.id }} .kd-faq { max-width: 52rem; }
  #shopify-section-{{ section.id }} .kd-faq details { border-bottom: 1px solid rgb(var(--color-border)); }
  #shopify-section-{{ section.id }} .kd-faq summary { cursor: pointer; padding: var(--sp-4) 0; font-weight: 600; list-style: none; display: flex; justify-content: space-between; align-items: center; gap: var(--sp-4); }
  #shopify-section-{{ section.id }} .kd-faq summary::-webkit-details-marker { display: none; }
  #shopify-section-{{ section.id }} .kd-faq summary::after { content: '+'; font-size: 1.4rem; line-height: 1; color: rgb(var(--kd-ink)); flex: none; }
  #shopify-section-{{ section.id }} .kd-faq details[open] summary::after { content: '−'; }
  #shopify-section-{{ section.id }} .kd-faq__answer { padding: 0 0 var(--sp-4); color: rgb(var(--color-foreground) / 0.78); font-size: 0.92rem; line-height: 1.7; }
</style>

<div class="section section--padding{% if section.settings.divider %} section--divider{% endif %}{% if section.settings.rounded %} section--rounded relative{% endif %}">
  <div class="page-width relative">

    {%- comment -%} ===== Breadcrumb ===== {%- endcomment -%}
    {%- if section.settings.show_breadcrumb -%}
      <nav class="kd-breadcrumb" aria-label="Breadcrumb">
        <ol class="kd-breadcrumb__list text-sm">
          <li class="kd-breadcrumb__item"><a href="{{ routes.root_url }}" class="kd-breadcrumb__link" aria-label="Home">{%- render 'icon', icon: 'home', size: 'sm' -%}</a></li>
          {%- if section.settings.crumb1_title != blank -%}
            <li class="kd-breadcrumb__sep" aria-hidden="true">{%- render 'icon', icon: 'chevron-right', size: 'xs' -%}</li>
            <li class="kd-breadcrumb__item">{%- if section.settings.crumb1_link != blank -%}<a href="{{ section.settings.crumb1_link }}" class="kd-breadcrumb__link">{{ section.settings.crumb1_title }}</a>{%- else -%}{{ section.settings.crumb1_title }}{%- endif -%}</li>
          {%- endif -%}
          {%- if section.settings.crumb2_title != blank -%}
            <li class="kd-breadcrumb__sep" aria-hidden="true">{%- render 'icon', icon: 'chevron-right', size: 'xs' -%}</li>
            <li class="kd-breadcrumb__item">{%- if section.settings.crumb2_link != blank -%}<a href="{{ section.settings.crumb2_link }}" class="kd-breadcrumb__link">{{ section.settings.crumb2_title }}</a>{%- else -%}{{ section.settings.crumb2_title }}{%- endif -%}</li>
          {%- endif -%}
          <li class="kd-breadcrumb__sep" aria-hidden="true">{%- render 'icon', icon: 'chevron-right', size: 'xs' -%}</li>
          <li class="kd-breadcrumb__item kd-breadcrumb__item--current" aria-current="page">{{ section.settings.heading | default: page.title }}</li>
        </ol>
      </nav>
    {%- endif -%}

    {%- comment -%} ===== Hero ===== {%- endcomment -%}
    <div class="kd-hero{% if section.settings.hero_image != blank %} kd-hero--media{% endif %}">
      <div class="kd-hero__text">
        {%- if section.settings.eyebrow != blank -%}<span class="kd-eyebrow">{{ section.settings.eyebrow }}</span>{%- endif -%}
        {%- if section.settings.heading != blank -%}<h1 class="{{ section.settings.heading_size }}">{{ section.settings.heading }}</h1>{%- endif -%}
        {%- if section.settings.intro != blank -%}<div class="kd-hero__intro rte">{{ section.settings.intro }}</div>{%- endif -%}
        {%- if section.settings.best_for != blank -%}<p class="kd-hero__bestfor">Best for {{ section.settings.best_for }}</p>{%- endif -%}
      </div>
      {%- if section.settings.hero_image != blank -%}
        <div class="kd-hero__media">{{ section.settings.hero_image | image_url: width: 900 | image_tag: loading: 'eager', widths: '400,600,800,900', sizes: '(min-width: 750px) 45vw, 90vw', alt: section.settings.heading }}</div>
      {%- endif -%}
    </div>

    {%- comment -%} ===== What it is ===== {%- endcomment -%}
    {%- if section.settings.what_it_is != blank -%}
      <div class="kd-block">
        {%- if section.settings.what_heading != blank -%}<div class="kd-block__head"><h2 class="title-md">{{ section.settings.what_heading }}</h2></div>{%- endif -%}
        <div class="kd-prose rte">{{ section.settings.what_it_is }}</div>
      </div>
    {%- endif -%}

    {%- comment -%} ===== Why choose (reason blocks) ===== {%- endcomment -%}
    {%- assign reason_blocks = section.blocks | where: 'type', 'reason' -%}
    {%- if reason_blocks.size > 0 -%}
      <div class="kd-block">
        {%- if section.settings.why_heading != blank -%}<div class="kd-block__head"><h2 class="title-md">{{ section.settings.why_heading }}</h2></div>{%- endif -%}
        <div class="kd-reasons">
          {%- for block in reason_blocks -%}
            <div class="kd-reason" {{ block.shopify_attributes }}>
              {%- if block.settings.title != blank -%}<p class="kd-reason__title">{{ block.settings.title }}</p>{%- endif -%}
              {%- if block.settings.text != blank -%}<p class="kd-reason__text">{{ block.settings.text }}</p>{%- endif -%}
            </div>
          {%- endfor -%}
        </div>
      </div>
    {%- endif -%}

    {%- comment -%} ===== Key features (feature blocks) ===== {%- endcomment -%}
    {%- assign feature_blocks = section.blocks | where: 'type', 'feature' -%}
    {%- if feature_blocks.size > 0 -%}
      <div class="kd-block kd-block--center">
        {%- if section.settings.features_heading != blank -%}<div class="kd-block__head"><h2 class="title-md">{{ section.settings.features_heading }}</h2></div>{%- endif -%}
        <div class="kd-features">
          {%- for block in feature_blocks -%}
            <div class="kd-feature" {{ block.shopify_attributes }}>
              {%- if block.settings.icon != blank -%}<div class="kd-feature__icon" aria-hidden="true">{{ block.settings.icon }}</div>{%- endif -%}
              {%- if block.settings.title != blank -%}<p class="kd-feature__title">{{ block.settings.title }}</p>{%- endif -%}
              {%- if block.settings.text != blank -%}<p class="kd-feature__text">{{ block.settings.text }}</p>{%- endif -%}
            </div>
          {%- endfor -%}
        </div>
      </div>
    {%- endif -%}

    {%- comment -%} ===== Who it's for ===== {%- endcomment -%}
    {%- if section.settings.who_for != blank -%}
      <div class="kd-block">
        {%- if section.settings.who_heading != blank -%}<div class="kd-block__head"><h2 class="title-md">{{ section.settings.who_heading }}</h2></div>{%- endif -%}
        <div class="kd-prose rte">{{ section.settings.who_for }}</div>
      </div>
    {%- endif -%}

    {%- comment -%} ===== Good to know (note blocks) ===== {%- endcomment -%}
    {%- assign note_blocks = section.blocks | where: 'type', 'note' -%}
    {%- if note_blocks.size > 0 -%}
      <div class="kd-block">
        {%- if section.settings.notes_heading != blank -%}<div class="kd-block__head"><h2 class="title-md">{{ section.settings.notes_heading }}</h2></div>{%- endif -%}
        <div class="kd-notes">
          {%- for block in note_blocks -%}
            <div class="kd-note" {{ block.shopify_attributes }}>
              {%- if block.settings.title != blank -%}<p class="kd-note__title">{{ block.settings.title }}</p>{%- endif -%}
              {%- if block.settings.text != blank -%}<p class="kd-note__text">{{ block.settings.text }}</p>{%- endif -%}
            </div>
          {%- endfor -%}
        </div>
      </div>
    {%- endif -%}

    {%- comment -%} ===== Shop this type (products by handle) ===== {%- endcomment -%}
    {%- if section.settings.product_handles != blank -%}
      {%- assign handles = section.settings.product_handles | split: ',' -%}
      <div class="kd-block kd-block--center">
        {%- if section.settings.shop_heading != blank -%}<div class="kd-block__head"><h2 class="title-md">{{ section.settings.shop_heading }}</h2></div>{%- endif -%}
        <div class="product-grid card-grid card-grid--4 mobile:card-grid--2 grid">
          {%- for h in handles -%}
            {%- assign handle = h | strip -%}
            {%- assign kd_product = all_products[handle] -%}
            {%- if kd_product != blank -%}
              {%- render 'product-card',
                product: kd_product,
                product_id: kd_product.id,
                section_id: section.id,
                lazy_load: true,
                image_ratio: settings.product_image_ratio,
                image_fill: settings.product_image_fill,
                show_secondary_image: settings.product_secondary_image,
                show_vendor: settings.product_vendor,
                show_rating: settings.product_rating,
                show_color_swatches: settings.product_color_swatches,
                show_quick_add: settings.product_quick_add,
                show_save_amount: settings.product_save_amount,
                save_type: settings.product_save_type
              -%}
            {%- endif -%}
          {%- endfor -%}
        </div>
        {%- if section.settings.shop_button_link != blank -%}
          <div class="kd-shop__cta"><a class="button button--primary" href="{{ section.settings.shop_button_link }}" is="hover-link"><span class="btn-fill" data-fill></span><span class="btn-text">{{ section.settings.shop_button_label | default: 'Shop all kettles' }}</span></a></div>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- comment -%} ===== Explore other kettles (related blocks) ===== {%- endcomment -%}
    {%- assign related_blocks = section.blocks | where: 'type', 'related' -%}
    {%- if related_blocks.size > 0 -%}
      <div class="kd-block">
        {%- if section.settings.related_heading != blank -%}<div class="kd-block__head"><h2 class="title-md">{{ section.settings.related_heading }}</h2></div>{%- endif -%}
        <div class="kd-related">
          {%- for block in related_blocks -%}
            {%- if block.settings.label != blank and block.settings.link != blank -%}
              <a class="kd-related__link" href="{{ block.settings.link }}" {{ block.shopify_attributes }}>{{ block.settings.label }} {%- render 'icon', icon: 'chevron-right', size: 'xs' -%}</a>
            {%- endif -%}
          {%- endfor -%}
        </div>
      </div>
    {%- endif -%}

    {%- comment -%} ===== FAQ (faq blocks) + FAQPage structured data ===== {%- endcomment -%}
    {%- assign faq_blocks = section.blocks | where: 'type', 'faq' -%}
    {%- if faq_blocks.size > 0 -%}
      <div class="kd-block">
        {%- if section.settings.faq_heading != blank -%}<div class="kd-block__head"><h2 class="title-md">{{ section.settings.faq_heading }}</h2></div>{%- endif -%}
        <div class="kd-faq">
          {%- for block in faq_blocks -%}
            {%- if block.settings.question != blank -%}
              <details {{ block.shopify_attributes }}>
                <summary>{{ block.settings.question }}</summary>
                <div class="kd-faq__answer rte">{{ block.settings.answer }}</div>
              </details>
            {%- endif -%}
          {%- endfor -%}
        </div>
      </div>

      <script type="application/ld+json">
        {
          "@context": "https://schema.org",
          "@type": "FAQPage",
          "mainEntity": [
            {%- assign valid_faqs = faq_blocks | where: 'settings.question' -%}
            {%- for block in faq_blocks -%}
              {%- if block.settings.question != blank -%}
                {
                  "@type": "Question",
                  "name": {{ block.settings.question | strip_html | json }},
                  "acceptedAnswer": { "@type": "Answer", "text": {{ block.settings.answer | strip_html | strip_newlines | json }} }
                }{% unless forloop.last %},{% endunless %}
              {%- endif -%}
            {%- endfor -%}
          ]
        }
      </script>
    {%- endif -%}

  </div>
</div>

{% schema %}
{
  "name": "Kettle detail",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "header", "content": "Breadcrumb" },
    { "type": "checkbox", "id": "show_breadcrumb", "label": "Show breadcrumb", "default": true },
    { "type": "text", "id": "crumb1_title", "label": "Crumb 1 title", "default": "Kettles" },
    { "type": "url", "id": "crumb1_link", "label": "Crumb 1 link" },
    { "type": "text", "id": "crumb2_title", "label": "Crumb 2 title", "default": "Find your kettle" },
    { "type": "url", "id": "crumb2_link", "label": "Crumb 2 link" },
    { "type": "header", "content": "Hero" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Chefman Kettle Guide" },
    { "type": "text", "id": "heading", "label": "Title (H1)", "default": "Kettle type" },
    {
      "type": "select", "id": "heading_size", "label": "Title size",
      "options": [
        { "value": "title-md", "label": "Medium" },
        { "value": "title-lg tracking-heading", "label": "Large" },
        { "value": "title-xl tracking-heading", "label": "Extra large" }
      ],
      "default": "title-lg tracking-heading"
    },
    { "type": "richtext", "id": "intro", "label": "Intro" },
    { "type": "text", "id": "best_for", "label": "Best for", "info": "Shown as an uppercase kicker, e.g. \"everyday speed & value\"." },
    { "type": "image_picker", "id": "hero_image", "label": "Hero image" },
    { "type": "header", "content": "What it is" },
    { "type": "text", "id": "what_heading", "label": "Heading", "default": "What it is" },
    { "type": "richtext", "id": "what_it_is", "label": "Body" },
    { "type": "header", "content": "Section headings" },
    { "type": "text", "id": "why_heading", "label": "Why heading", "default": "Why choose it" },
    { "type": "text", "id": "features_heading", "label": "Features heading", "default": "Key features" },
    { "type": "text", "id": "who_heading", "label": "Who it's for heading", "default": "Who it's for" },
    { "type": "richtext", "id": "who_for", "label": "Who it's for body" },
    { "type": "text", "id": "notes_heading", "label": "Good-to-know heading", "default": "Good to know" },
    { "type": "header", "content": "Shop this type" },
    { "type": "text", "id": "product_handles", "label": "Product handles", "info": "Comma-separated product handles to feature (rendered live). Leave blank to hide." },
    { "type": "text", "id": "shop_heading", "label": "Shop heading", "default": "Shop these kettles" },
    { "type": "text", "id": "shop_button_label", "label": "Shop button label", "default": "Shop all kettles" },
    { "type": "url", "id": "shop_button_link", "label": "Shop button link" },
    { "type": "header", "content": "Explore other kettles" },
    { "type": "text", "id": "related_heading", "label": "Related heading", "default": "Explore other kettle types" },
    { "type": "header", "content": "FAQ" },
    { "type": "text", "id": "faq_heading", "label": "FAQ heading", "default": "Frequently asked questions" },
    { "type": "header", "content": "Section" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 120, "step": 4, "unit": "px", "label": "Padding top", "default": 64 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 120, "step": 4, "unit": "px", "label": "Padding bottom", "default": 100 },
    { "type": "checkbox", "id": "divider", "label": "Show divider", "default": false },
    { "type": "checkbox", "id": "rounded", "label": "Rounded section", "default": false }
  ],
  "blocks": [
    { "type": "reason", "name": "Why-choose reason", "settings": [
      { "type": "text", "id": "title", "label": "Title" },
      { "type": "textarea", "id": "text", "label": "Text" }
    ] },
    { "type": "feature", "name": "Feature", "settings": [
      { "type": "text", "id": "icon", "label": "Emoji" },
      { "type": "text", "id": "title", "label": "Title" },
      { "type": "textarea", "id": "text", "label": "Text" }
    ] },
    { "type": "note", "name": "Good-to-know note", "settings": [
      { "type": "text", "id": "title", "label": "Title" },
      { "type": "textarea", "id": "text", "label": "Text" }
    ] },
    { "type": "related", "name": "Related link", "settings": [
      { "type": "text", "id": "label", "label": "Label" },
      { "type": "url", "id": "link", "label": "Link" }
    ] },
    { "type": "faq", "name": "FAQ", "settings": [
      { "type": "text", "id": "question", "label": "Question" },
      { "type": "richtext", "id": "answer", "label": "Answer" }
    ] }
  ],
  "max_blocks": 40,
  "presets": [ { "name": "Kettle detail" } ]
}
{% endschema %}
