        "title": {
          "type": "title",
          "settings": {
            "title_size": "product-title-md",
            "title_size_mobile": "product-title-md",
            "show_price": true,
            "show_rating": true
          }
        },
        "excerpt": {
          "type": "text",
          "settings": {
            "text": "Cette zone sert à décrire les détails de votre produit. Parlez aux clients de l'apparence, du toucher et du style de votre produit. Ajoutez des détails sur la couleur, les matériaux utilisés, la taille et le lieu de fabrication.",
            "text_size": "text-base"
          }
        },
        "countdown": {
          "type": "countdown",
          "settings": {
            "heading": "Faites vite!",
            "subheading": "La vente se termine dans :",
            "color_text": "#e11d48",
            "color_background": "#fff1f2",
            "gradient_background": ""
