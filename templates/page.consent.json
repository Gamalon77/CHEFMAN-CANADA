        "liquid": "<script>\n(function() {\n  var params = new URLSearchParams(window.location.search);\n  if (params.get('success') !== 'true') return;\n\n  function deleteAllCookies() {\n    var cookies = document.cookie.split(';');\n    var hostname = window.location.hostname;\n    var parts = hostname.split('.');\n    var domains = [hostname, '.' + hostname];\n    if (parts.length > 2) {\n      var root = parts.slice(-2).join('.');\n      domains.push(root, '.' + root);\n    }\n    cookies.forEach(function(c) {\n      var eq = c.indexOf('=');\n      var name = (eq > -1 ? c.substring(0, eq) : c).trim();\n      document.cookie = name + '=;expires=Thu, 01 Jan 1970 00:00:00 GMT;path=/';\n      domains.forEach(function(d) {\n        document.cookie = name + '=;expires=Thu, 01 Jan 1970 00:00:00 GMT;path=/;domain=' + d;\n      });\n    });\n  }\n\n  function revokeConsent() {\n    if (typeof window.gtag === 'function') {\n      window.gtag('consent', 'update', {\n        analytics_storage: 'denied',\n        ad_storage: 'denied',\n        ad_user_data: 'denied',\n        ad_personalization: 'denied'\n      });\n    }\n    if (typeof window.fbq === 'function') { window.fbq('consent', 'revoke'); }\n    try { localStorage.setItem('shopify_ccpa_opt_out', '1'); } catch(e) {}\n    deleteAllCookies();\n    setTimeout(function() { window.location.replace(window.location.pathname); }, 500);\n  }\n\n  function run() {\n    if (window.Shopify && window.Shopify.customerPrivacy) {\n      window.Shopify.customerPrivacy.setTrackingConsent({\n        marketing: false,\n        analytics: false,\n        preferences: false\n      }, revokeConsent);\n    } else if (window.Shopify && typeof window.Shopify.loadFeatures === 'function') {\n      window.Shopify.loadFeatures([{\n        name: 'consent-tracking-api',\n        version: '0.1',\n        onLoad: function() {\n          window.Shopify.customerPrivacy.setTrackingConsent({\n            marketing: false,\n            analytics: false,