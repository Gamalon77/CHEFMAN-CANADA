    "faq_87ATea": {
      "type": "faq",
      "blocks": {
        "question_XKYa9J": {
          "type": "question",
          "settings": {
            "title": "<strong>1. Unplug the unit<\/strong>",
            "text": "<p>Make sure the unit is unplugged and cooled.<\/p>",
            "highlighted_text": "none",
            "highlighted_scribble": "circle"
          }
        },
        "question_UrcU4r": {
          "type": "question",
          "settings": {
            "title": "<strong>2. Remove Coffee Pod<\/strong>",
            "text": "<p>If a coffee pod was used, remove the capsule receptacle with the pod. Discard the pod.<\/p>",
            "highlighted_text": "none",
            "highlighted_scribble": "circle"
          }
        },
        "question_XkRbAP": {
          "type": "question",
          "settings": {
            "title": "<strong>3. Remove any coffee grounds<\/strong>",
            "text": "<p>If coffee grounds were used, remove the reusable coffee filter. Discard the grounds, then rinse the niter with water, and dry completely.<br\/><br\/><strong>NOTE: <\/strong>Be sure to discard brewed coffee grounds promptly. If they sit in the brew chamber or coffee filter for an extended period of time, they may begin to mold.<\/p>",
            "highlighted_text": "none",
            "highlighted_scribble": "circle"
          }
        },
        "question_hkEim8": {
          "type": "question",
          "settings": {
            "title": "<strong>4. Empty and clean the water reservoir<\/strong>",
            "text": "<p>For fresh-tasting coffee, empty the water reservoir between uses. Wash the reservoir as needed with warm, soapy water. Rinse and dry well.<\/p>",
            "highlighted_text": "none",
            "highlighted_scribble": "circle"
          }
        },
        "question_rwKNNL": {
          "type": "question",
          "settings": {
            "title": "<strong>5. Replace the water filter<\/strong>",
            "text": "<p>Replace the charcoal water filter cartridge every 1 to 2 months, at a minimum, following the instructions on page 10, steps 4-6<\/p>",
            "highlighted_text": "none",
            "highlighted_scribble": "circle"
          }
        },
        "question_xtLMA7": {
          "type": "question",
          "settings": {
            "title": "<strong>6. Rinse and wash trivet and drip tray<\/strong>",
            "text": "<p>If necessary, rinse and wash the trivet and drip tray with a sponge and warm, soapy water.<\/p>",
            "highlighted_text": "none",
            "highlighted_scribble": "circle"
          }
        },
        "question_iQqmA8": {
          "type": "question",
          "settings": {
            "title": "<strong>7. Wipe down the base of the unit<\/strong>",
            "text": "<p>Wipe down the base of the unit with a damp cloth or sponge, if needed. Dry completely. <em>Never immerse the coffee maker or its plug in water.<\/em><br\/><br\/><strong>NOTE:<\/strong> The coffee maker and its accessories are <strong>NOT<\/strong> <strong>dishwasher safe.<\/strong><\/p>",
            "highlighted_text": "none",
            "highlighted_scribble": "circle"
          }
        }
      },
