    "faq_XfWmqx": {
      "type": "faq",
      "blocks": {
        "question_M96gYA": {
          "type": "question",
          "settings": {
            "title": "<strong>1. Empty the water reservoir<\/strong>",
            "text": "<p>Empty the water reservoir completely and return it to the base. Put the empty capsule receptacle in the brew chamber and close the lid.<\/p>",
            "highlighted_text": "none",
            "highlighted_scribble": "circle"
          }
        },
        "question_czVMga": {
          "type": "question",
          "settings": {
            "title": "<strong>2. Prepare Your Descaling Solution<\/strong>",
            "text": "<p>Prepare a commercial descaler according to the package directions OR a 50\/50 mix of water and distilled vinegar. Fill the water reservoir completely with the mixture.<\/p>",
            "highlighted_text": "none",
            "highlighted_scribble": "circle"
          }
        },
        "question_9hFett": {
          "type": "question",
          "settings": {
            "title": "<strong>3. Position an empty cup<\/strong>",
            "text": "<p>Plug in the unit. Place a large cup (at least 12 oz.) under the brew head.<\/p>",
            "highlighted_text": "none",
            "highlighted_scribble": "circle"
          }
        },
        "question_XENzpY": {
          "type": "question",
          "settings": {
            "title": "<strong>4. Run your first descaling cycle<\/strong>",
            "text": "<p>Press the <strong>CLEAN <\/strong>button, then the <strong>BREW | STOP <\/strong>button. The unit will cycle the cleaning solution through its internal parts and dispense into the cup<\/p>",
            "highlighted_text": "none",
            "highlighted_scribble": "circle"
          }
        },
        "question_gFf8C3": {
          "type": "question",
          "settings": {
            "title": "<strong>5. Remove water from cup<\/strong>",
            "text": "<p>When the cycle has finished, discard the liquid in the cup and return the cup to the trivet. Press <strong>BREW | STOP <\/strong>again.<\/p>",
            "highlighted_text": "none",
            "highlighted_scribble": "circle"
          }
        },
        "question_hUfDAP": {
          "type": "question",
          "settings": {
            "title": "<strong>6. Repeat steps 4 and 5<\/strong>",
            "text": "<p>Repeat until the <strong>LOW WATER <\/strong>light comes on<\/p>",
            "highlighted_text": "none",
            "highlighted_scribble": "circle"
          }
        },
        "question_awNen6": {
          "type": "question",
          "settings": {
            "title": "<strong>7. Rinse water tank and refill<\/strong>",
            "text": "<p>Rinse the water reservoir thoroughly. Return it to the base and refill with<br\/>fresh water.<\/p>",
            "highlighted_text": "none",
            "highlighted_scribble": "circle"
          }
        },
        "question_excKjA": {
          "type": "question",
          "settings": {
            "title": "<strong>8. Repeat until water runs low<\/strong>",
            "text": "<p>Repeat the cleaning cycles, emptying the cup each time, until the <strong>LOW WATER <\/strong>light comes on.<\/p>",
            "highlighted_text": "none",
            "highlighted_scribble": "circle"
          }
        },
        "question_3Ej7WN": {
          "type": "question",
          "settings": {
            "title": "<strong>9. Return to Standby mode<\/strong>",
            "text": "<p>Press <strong>CLEAN <\/strong>to return to Standby mode.<\/p>",
            "highlighted_text": "none",
            "highlighted_scribble": "circle"
          }
        }
      },
